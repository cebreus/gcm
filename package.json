{
  "name": "gcm",
  "version": "0.1.0",
  "type": "module",
  "main": "gcm.js",
  "scripts": {
    "start": "bun run ./gcm.js",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write .",
    "build": "bun build ./gcm.ts --outfile ./dist/gcm --target=node --minify"
  },
  "dependencies": {
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.10.1",
    "@typescript-eslint/eslint-plugin": "^8.47.0",
    "@typescript-eslint/parser": "^8.47.0",
    "eslint": "^9.36.0",
    "eslint-config-love": "^133.0.0",
    "eslint-plugin-vue": "^10.5.1",
    "jiti": "^2.6.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1"
  }
}
