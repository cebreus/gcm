{
  "name": "gcm",
  "version": "0.6.1",
  "main": "gcm.js",
  "scripts": {
    "start": "bun run ./gcm.js",
    "test": "bun test",
    "check": "bunx tsc --noEmit",
    "lint": "eslint",
    "format": "eslint --fix . --ignore-pattern dist && prettier -l -w .",
    "build": "bun build ./gcm.ts --outfile ./dist/gcm --target=bun --minify"
  },
  "devDependencies": {
    "@clack/prompts": "^1.1.0",
    "@types/bun": "^1.3.10",
    "@types/minimist": "^1.2.5",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "clipboardy": "^5.3.1",
    "eslint": "^10.0.3",
    "eslint-config-love": "^151.0.0",
    "globals": "^17.4.0",
    "minimist": "^1.2.8",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1"
  },
  "type": "module"
}
