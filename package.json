{
  "name": "gcm",
  "version": "0.2.0",
  "type": "module",
  "main": "gcm.js",
  "scripts": {
    "start": "bun run ./gcm.js",
    "test": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier -l -w .",
    "build": "bun build ./gcm.ts --outfile ./dist/gcm --target=node --minify"
  },
  "devDependencies": {
    "@clack/prompts": "^0.11.0",
    "@types/bun": "^1.3.4",
    "@types/minimist": "^1.2.5",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "eslint": "^9.39.2",
    "eslint-config-love": "^137.0.0",
    "globals": "^16.5.0",
    "minimist": "^1.2.8",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1"
  }
}
