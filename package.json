{
  "name": "gcm",
  "version": "0.14.0",
  "scripts": {
    "start": "bun run ./gcm.ts",
    "test": "bun test --isolate",
    "test:binary-contract": "bun test --isolate test/binary-contract.test.ts",
    "check": "bunx tsc --noEmit",
    "lint": "eslint && prettier --check .",
    "format": "eslint --fix . --ignore-pattern dist && prettier -l -w .",
    "build": "bun build ./gcm.ts --outfile ./dist/gcm --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig --minify",
    "verify:push": "bun run check && bun run lint && bun run test",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@trivago/prettier-plugin-sort-imports": "6.0.2",
    "@types/bun": "^1.4.0",
    "@types/minimist": "^1.2.5",
    "eslint": "9.39.5",
    "eslint-config-love": "^155.0.0",
    "globals": "^17.11.0",
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.6",
    "typescript": "6.0.2"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "type": "module",
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "clipboardy": "5.3.2",
    "minimist": "1.2.8"
  }
}
